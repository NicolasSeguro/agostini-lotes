# ============================================================================
# ERP AGOSTINI - Variables de entorno
# ============================================================================
# Este archivo se sube al repo como referencia. NO contiene valores reales.
# Cada entorno (local, produccion) tiene su propio .env / Railway env vars.
# ============================================================================


# -----------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------
# En PRODUCCION (Railway): usar DATABASE_URL (connection string completo).
# Railway lo provee automaticamente cuando agregas el servicio PostgreSQL.
# Ejemplo (no usar este valor):
#   DATABASE_URL=postgresql://user:pass@host.railway.app:5432/railway
DATABASE_URL=

# En DESARROLLO LOCAL: si DATABASE_URL no esta, se usan estas 5 vars.
# Si dejas DATABASE_URL vacio, podes definir las individuales:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin123
DB_NAME=ADI_ERP


# -----------------------------------------------------------------------
# JWT (sesiones de usuario)
# -----------------------------------------------------------------------
# Secreto para firmar/verificar tokens JWT. Si no se setea en produccion,
# la app NO va a arrancar (es obligatorio para evitar deploys inseguros).
#
# Generar uno nuevo y seguro con:
#   - Linux/Mac:   openssl rand -base64 64
#   - Node:        require('crypto').randomBytes(64).toString('base64')
#   - PowerShell:  [Convert]::ToBase64String((1..64 | %{[byte](Get-Random -Max 256)}))
#
# Ejemplo (NO usar este valor, generar uno propio):
#   JWT_SECRET=8KypGLvVyz2blWr1KaQz1aoe_Hdvs7ps4cNbkeQo97wWoepshePDA57WI0BEWQ0BIh1U5bdgq013Z9kIXSucIg
JWT_SECRET=


# -----------------------------------------------------------------------
# NEXT.JS
# -----------------------------------------------------------------------
# Definido automaticamente por Next.js / Railway en produccion.
# En local lo dejamos vacio (default: development).
# NODE_ENV=production


# -----------------------------------------------------------------------
# MODULO BOLETOS (opcional - solo si esta activo)
# -----------------------------------------------------------------------
# Path al ejecutable de LibreOffice para generar Word/PDF.
# En Railway requiere Dockerfile custom con LibreOffice instalado.
# Por defecto en Linux: /usr/bin/soffice
# En Windows local:     C:\Program Files\LibreOffice\program\soffice.exe
# LIBREOFFICE_PATH=
